services:
  nginx:
    image: nginx:alpine
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf
      - ./certbot-certs:/etc/letsencrypt        # ← chemin local
      - ./certbot-www:/var/www/certbot           # ← chemin local
    depends_on:
      - frontend
      - backend
    restart: always

  frontend:
    build:
      context: ./admin/my-da
